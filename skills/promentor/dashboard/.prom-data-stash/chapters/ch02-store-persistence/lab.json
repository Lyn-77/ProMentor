{
  "chapter_id": "ch02-store-persistence",
  "title": "Store 持久化层",
  "description": "实现内存唯一真相 + 异步落盘的设备存储层，含并发安全 CRUD 与纯校验函数",
  "language": "go",
  "package": "store",
  "files": [
    {
      "path": "store.go",
      "description": "Store 数据仓库核心实现"
    }
  ],
  "interface": {
    "types": [
      {
        "name": "Device",
        "kind": "struct",
        "doc": "一个可唤醒的网络设备。字段：Name, MAC string; Port int; Address string"
      },
      {
        "name": "Store",
        "kind": "struct",
        "doc": "设备数据仓库，内存缓存 + 读写锁 + JSON 落盘"
      }
    ],
    "errors": [
      "ErrNameDuplicate", "ErrNameEmpty", "ErrMACInvalid", "ErrMACPartial", "ErrPortInvalid", "ErrIPInvalid", "ErrNotFound"
    ],
    "functions": [
      {
        "signature": "func New(dataDir string) (*Store, error)",
        "doc": "创建数据目录并加载已有数据；文件损坏时重置为空数据不报错"
      },
      {
        "signature": "func (s *Store) Add(d Device) error",
        "doc": "新增设备，名称唯一（大小写不敏感），重复返回 ErrNameDuplicate"
      },
      {
        "signature": "func (s *Store) Update(idx int, d Device) error",
        "doc": "按索引更新，越界返回 ErrNotFound；名称唯一性排除自身"
      },
      {
        "signature": "func (s *Store) Delete(idx int) error",
        "doc": "按索引删除，越界返回 ErrNotFound"
      },
      {
        "signature": "func (s *Store) FindByName(name string) (Device, int, error)",
        "doc": "按名称查找（大小写不敏感），返回设备、索引、错误"
      },
      {
        "signature": "func (s *Store) FindByIndex(idx int) (Device, error)",
        "doc": "按索引查找，越界返回 ErrNotFound"
      },
      {
        "signature": "func (s *Store) List() []Device",
        "doc": "返回设备列表的只读副本，外部修改不影响内部状态"
      },
      {
        "signature": "func (s *Store) Count() int",
        "doc": "返回设备数量"
      },
      {
        "signature": "func (s *Store) Save() error",
        "doc": "将当前内存数据序列化为 JSON 写入磁盘"
      },
      {
        "signature": "func ValidateMAC(s string) (string, error)",
        "doc": "校验并标准化 MAC 为 XX:XX:XX:XX:XX:XX。输入不足返回 ErrMACPartial，超长返回 ErrMACInvalid"
      },
      {
        "signature": "func ValidatePort(port int) error",
        "doc": "校验端口 1-65535，否则 ErrPortInvalid"
      },
      {
        "signature": "func ValidateIP(ip string) error",
        "doc": "校验 IPv4 地址格式，否则 ErrIPInvalid"
      },
      {
        "signature": "func ValidateName(name string) error",
        "doc": "校验名称非空（TrimSpace 后），否则 ErrNameEmpty"
      }
    ]
  },
  "test_command": "cd {chapter_dir} && go test -v ./..."
}
