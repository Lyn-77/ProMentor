{
  "chapter_id": "ch04-modal-state-machine",
  "title": "模态状态机",
  "description": "实现 mode 字段驱动的模态状态机：dd 双键删除、多选、确认弹窗",
  "language": "go",
  "package": "modal",
  "files": [
    {
      "path": "modal.go",
      "description": "模态列表 Model 核心实现"
    }
  ],
  "interface": {
    "types": [
      {
        "name": "Mode",
        "kind": "type",
        "doc": "模态类型：ModeNormal / ModeMultiSelect / ModeConfirm"
      },
      {
        "name": "Model",
        "kind": "struct",
        "doc": "模态列表模型。字段：items []string; cursor int; mode Mode; selected map[int]bool; pendingD bool"
      }
    ],
    "constants": [
      "ModeNormal", "ModeMultiSelect", "ModeConfirm"
    ],
    "functions": [
      {
        "signature": "func New(items []string) Model",
        "doc": "创建模态列表，cursor=0，mode=ModeNormal"
      },
      {
        "signature": "func (m Model) Init() tea.Cmd",
        "doc": "返回 nil"
      },
      {
        "signature": "func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd)",
        "doc": "按当前模式处理按键：普通模式 j/k 移动、space 进多选、dd 进确认、q 退出；多选模式 space 切换选中、q/esc 返回；确认模式 y/enter 删除当前项、n/esc 取消"
      },
      {
        "signature": "func (m Model) View() string",
        "doc": "渲染列表视图"
      },
      {
        "signature": "func (m Model) Cursor() int",
        "doc": "返回当前光标索引"
      },
      {
        "signature": "func (m Model) Mode() Mode",
        "doc": "返回当前模态"
      },
      {
        "signature": "func (m Model) Selected() []int",
        "doc": "返回已选中索引，升序排列"
      },
      {
        "signature": "func (m Model) Items() []string",
        "doc": "返回当前列表项"
      }
    ]
  },
  "test_command": "cd {chapter_dir} && go test -v ./..."
}
