{
  "chapter_id": "ch07-final-assembly",
  "title": "组装 WakeUp",
  "description": "组装全书：内存 Store + 模态状态机 + 异步批量唤醒 + 结果回环",
  "language": "go",
  "package": "app",
  "files": [
    {
      "path": "app.go",
      "description": "App 主模型 + Store 核心实现"
    }
  ],
  "interface": {
    "types": [
      {
        "name": "Device",
        "kind": "struct",
        "doc": "可唤醒设备。字段：Name, MAC, Address string; Port int"
      },
      {
        "name": "WakeFunc",
        "kind": "type",
        "doc": "type WakeFunc func(mac, addr string, port int) error"
      },
      {
        "name": "Mode",
        "kind": "type",
        "doc": "模态类型：ModeNormal / ModeConfirm / ModeWakeConfirm / ModeMultiSelect / ModeBatchWakeConfirm"
      },
      {
        "name": "Store",
        "kind": "struct",
        "doc": "内存设备仓库，并发安全"
      },
      {
        "name": "WakeMsg",
        "kind": "struct",
        "doc": "单设备唤醒结果消息。字段：Err error; Name string"
      },
      {
        "name": "WakeResult",
        "kind": "struct",
        "doc": "单次唤醒结果。字段：Name string; Err error"
      },
      {
        "name": "BatchWakeMsg",
        "kind": "struct",
        "doc": "批量唤醒结果消息。字段：Results []WakeResult"
      },
      {
        "name": "App",
        "kind": "struct",
        "doc": "端到端应用模型"
      }
    ],
    "constants": [
      "ModeNormal", "ModeConfirm", "ModeWakeConfirm", "ModeMultiSelect", "ModeBatchWakeConfirm"
    ],
    "functions": [
      {
        "signature": "func NewStore() *Store",
        "doc": "创建空设备仓库"
      },
      {
        "signature": "func (s *Store) Add(d Device) error",
        "doc": "追加设备"
      },
      {
        "signature": "func (s *Store) Delete(idx int) error",
        "doc": "按索引删除，越界返回错误"
      },
      {
        "signature": "func (s *Store) FindByIndex(idx int) (Device, error)",
        "doc": "按索引查找"
      },
      {
        "signature": "func (s *Store) List() []Device",
        "doc": "返回设备列表副本"
      },
      {
        "signature": "func (s *Store) Count() int",
        "doc": "设备数量"
      },
      {
        "signature": "func NewApp(s *Store, wake WakeFunc) App",
        "doc": "创建 App，cursor=0，mode=ModeNormal"
      },
      {
        "signature": "func (m App) Init() tea.Cmd",
        "doc": "返回 nil"
      },
      {
        "signature": "func (m App) Update(msg tea.Msg) (tea.Model, tea.Cmd)",
        "doc": "处理按键与异步结果消息：j/k 移动，enter 唤醒确认，space 多选，dd 删除确认，q 退出；WakeMsg/BatchWakeMsg 累加成功计数"
      },
      {
        "signature": "func (m App) View() string",
        "doc": "渲染设备列表"
      },
      {
        "signature": "func (m App) Cursor() int",
        "doc": "当前光标索引"
      },
      {
        "signature": "func (m App) Mode() Mode",
        "doc": "当前模态"
      },
      {
        "signature": "func (m App) Items() []string",
        "doc": "设备名称列表"
      },
      {
        "signature": "func (m App) WakeCount() int",
        "doc": "已处理的成功唤醒数（WakeMsg/BatchWakeMsg 中 Err==nil 的结果）"
      },
      {
        "signature": "func (m App) DeletedCount() int",
        "doc": "已删除的设备数"
      }
    ]
  },
  "test_command": "cd {chapter_dir} && go test -v ./..."
}
