{
  "chapter_id": "ch06-form-validation",
  "title": "表单与双重校验",
  "description": "实现两字段表单：实时宽松校验 + 提交严格校验 + 默认值替换",
  "language": "go",
  "package": "form",
  "files": [
    {
      "path": "form.go",
      "description": "表单 Model 核心实现"
    }
  ],
  "interface": {
    "types": [
      {
        "name": "Model",
        "kind": "struct",
        "doc": "两字段表单模型。字段 0=名称，1=端口"
      }
    ],
    "functions": [
      {
        "signature": "func New() Model",
        "doc": "创建表单，focus=0，无值无错误，未提交"
      },
      {
        "signature": "func (m Model) Init() tea.Cmd",
        "doc": "返回 nil"
      },
      {
        "signature": "func (m Model) Update(msg tea.Msg) (tea.Model, tea.Cmd)",
        "doc": "字符输入追加到聚焦字段+实时宽松校验；backspace 删除；enter/tab 严格校验当前字段后移动焦点或提交"
      },
      {
        "signature": "func (m Model) View() string",
        "doc": "渲染表单视图"
      },
      {
        "signature": "func (m Model) Value(i int) string",
        "doc": "第 i 个字段的当前值"
      },
      {
        "signature": "func (m Model) Error(i int) string",
        "doc": "第 i 个字段的当前错误信息，无错误为空串"
      },
      {
        "signature": "func (m Model) Focus() int",
        "doc": "当前聚焦字段索引"
      },
      {
        "signature": "func (m Model) Submitted() bool",
        "doc": "是否已完成提交"
      },
      {
        "signature": "func (m Model) SubmittedPort() int",
        "doc": "提交时的端口值；空端口提交时默认 9"
      }
    ]
  },
  "test_command": "cd {chapter_dir} && go test -v ./..."
}
